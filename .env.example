# Local default (no Docker): SQLite file in backend/
DATABASE_URL=sqlite:///./vpilot.db
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://frontend-coral-five-99.vercel.app

# Hosted LLM configuration for backend only
# Example values for OpenAI-compatible Qwen providers:
# LLM_BASE_URL=https://api.provider.example/v1
# LLM_API_KEY=your_api_key_here
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Keep these unset or set them in your deployment environment for production.
# Do not put the API key in the React frontend.
